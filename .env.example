# Cloudflare Worker API Endpoints
# These should be your deployed Cloudflare Worker URLs
VITE_CALENDAR_API_URL=https://your-calendar-worker.your-subdomain.workers.dev
VITE_FLICKR_API_URL=https://your-flickr-worker.your-subdomain.workers.dev

# For local development, you can still use Netlify functions
# VITE_CALENDAR_API_URL=/.netlify/functions/calendar-api
# VITE_FLICKR_API_URL=/.netlify/functions/flickr-api